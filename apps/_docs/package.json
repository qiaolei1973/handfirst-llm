{
  "name": "_docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "predev": "tsx scripts/generate-all.ts",
    "prebuild": "tsx scripts/generate-all.ts",
    "predev:force": "tsx scripts/generate-all.ts --force",
    "prebuild:force": "tsx scripts/generate-all.ts --force",
    "dev:force": "npm run predev:force && next dev --port 3000",
    "build:force": "npm run prebuild:force && next build"
  },
  "dependencies": {
    "highlight.js": "^11.0.0",
    "marked": "^15.0.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
