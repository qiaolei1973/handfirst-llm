# ── 概念地图：机器学习概念层级 ──
#   由 generate-all.ts 自动构建，输出到 public/recap/concept-map.svg
#
#   按 training loop 五环节分组：
#     模型(前向+反向) / 损失 / 优化器 / 数据 / 防线
#   容器内用嵌套容器表达层级，箭头只连顶层

vars: {
  d2-config: {
    layout-engine: dagre
  }
}

direction: down

row1: "" { style.opacity: 0; width: 1; height: 1 }
row2: "" { style.opacity: 0; width: 1; height: 1 }

# ============================================================
# 模型 = Forward + Backward
# ============================================================
model: {
  label: "模型  (Forward + Backward)"
  style.fill: "#eff6ff"
  style.stroke: "#3b82f6"
  style.stroke-width: 2; style.border-radius: 12
  style.font-size: 14; style.font-color: "#1d4ed8"; style.bold: true

  fw: "Forward（前向）" {
    style.fill: "#dbeafe"; style.stroke: "#93c5fd"
    style.stroke-width: 1; style.border-radius: 8
    style.font-size: 11; style.font-color: "#2563eb"; style.bold: true
    grid-rows: 3; grid-columns: 2; grid-gap: 3

    a1: "Linear  Wx+b"       { width: 75; height: 30;
      style.fill: "#eff6ff"; style.stroke: "#bfdbfe"; style.border-radius: 4
      style.font-size: 9; style.font-color: "#1d4ed8" }
    a2: "ReLU  max(0,z)"     { width: 75; height: 30;
      style.fill: "#eff6ff"; style.stroke: "#bfdbfe"; style.border-radius: 4
      style.font-size: 9; style.font-color: "#1d4ed8" }
    a3: "神经元  L+ReLU"     { width: 75; height: 30;
      style.fill: "#bfdbfe"; style.stroke: "#93c5fd"; style.border-radius: 4
      style.font-size: 9; style.font-color: "#1e40af" }
    a4: "隐藏层  N 个并行"   { width: 75; height: 30;
      style.fill: "#bfdbfe"; style.stroke: "#93c5fd"; style.border-radius: 4
      style.font-size: 9; style.font-color: "#1e40af" }
    a5: "输出层  Linear"     { width: 75; height: 30;
      style.fill: "#bfdbfe"; style.stroke: "#93c5fd"; style.border-radius: 4
      style.font-size: 9; style.font-color: "#1e40af" }
    a6: "Layer.forward()"    { width: 75; height: 30;
      style.fill: "#93c5fd"; style.stroke: "#60a5fa"; style.border-radius: 4
      style.font-size: 9; style.font-color: "#1e3a5f" }
  }

  bw: "Backward（反向）" {
    style.fill: "#fee2e2"; style.stroke: "#fca5a5"
    style.stroke-width: 1; style.border-radius: 8
    style.font-size: 11; style.font-color: "#dc2626"; style.bold: true
    grid-rows: 3; grid-columns: 2; grid-gap: 3

    b1: "梯度  dL/d参数"     { width: 75; height: 30;
      style.fill: "#fef2f2"; style.stroke: "#fecaca"; style.border-radius: 4
      style.font-size: 9; style.font-color: "#b91c1c" }
    b2: "链式法则"           { width: 75; height: 30;
      style.fill: "#fef2f2"; style.stroke: "#fecaca"; style.border-radius: 4
      style.font-size: 9; style.font-color: "#b91c1c" }
    b3: "反向传播"           { width: 75; height: 30;
      style.fill: "#fecaca"; style.stroke: "#fca5a5"; style.border-radius: 4
      style.font-size: 9; style.font-color: "#991b1b" }
    b4: "收 → 算 → 传"      { width: 75; height: 30;
      style.fill: "#fecaca"; style.stroke: "#fca5a5"; style.border-radius: 4
      style.font-size: 9; style.font-color: "#991b1b" }
    b5: "Layer.backward()"   { width: 75; height: 30;
      style.fill: "#fca5a5"; style.stroke: "#f87171"; style.border-radius: 4
      style.font-size: 9; style.font-color: "#7f1d1d" }
    b6: "" { width: 75; height: 30; style.opacity: 0 }
  }
}

# ============================================================
# 损失
# ============================================================
loss: {
  label: "损失  (Loss)"
  style.fill: "#fef2f2"
  style.stroke: "#ef4444"
  style.stroke-width: 2; style.border-radius: 10
  style.font-size: 13; style.font-color: "#991b1b"; style.bold: true

  grid-rows: 2; grid-columns: 2; grid-gap: 5

  l1: "MAE  |差|的均值"        { width: 80; height: 34;
    style.fill: "#fee2e2"; style.stroke: "#fca5a5"; style.border-radius: 5
    style.font-size: 9; style.font-color: "#b91c1c" }
  l2: "MSE  差²的均值 (默认)"  { width: 80; height: 34;
    style.fill: "#fecaca"; style.stroke: "#f87171"; style.border-radius: 5
    style.font-size: 9; style.font-color: "#991b1b" }
  l3: "训练损失  看拟合"        { width: 80; height: 34;
    style.fill: "#fee2e2"; style.stroke: "#fca5a5"; style.border-radius: 5
    style.font-size: 9; style.font-color: "#b91c1c" }
  l4: "验证损失  看泛化"        { width: 80; height: 34;
    style.fill: "#fecaca"; style.stroke: "#f87171"; style.border-radius: 5
    style.font-size: 9; style.font-color: "#991b1b" }
}

# ============================================================
# 优化器
# ============================================================
opt: {
  label: "优化器  (Optimizer)"
  style.fill: "#ecfdf5"
  style.stroke: "#10b981"
  style.stroke-width: 2; style.border-radius: 10
  style.font-size: 13; style.font-color: "#065f46"; style.bold: true

  grid-rows: 3; grid-columns: 2; grid-gap: 4

  o1: "梯度下降  W−=lr·grad" { width: 82; height: 32;
    style.fill: "#d1fae5"; style.stroke: "#a7f3d0"; style.border-radius: 4
    style.font-size: 9; style.font-color: "#065f46" }
  o2: "SGD  采样+GD"          { width: 82; height: 32;
    style.fill: "#a7f3d0"; style.stroke: "#6ee7b7"; style.border-radius: 4
    style.font-size: 9; style.font-color: "#064e3b" }
  o3: "Momentum  惯性"        { width: 82; height: 32;
    style.fill: "#6ee7b7"; style.stroke: "#34d399"; style.border-radius: 4
    style.font-size: 9; style.font-color: "#064e3b" }
  o4: "RMSProp  自适应lr"     { width: 82; height: 32;
    style.fill: "#6ee7b7"; style.stroke: "#34d399"; style.border-radius: 4
    style.font-size: 9; style.font-color: "#064e3b" }
  o5: "★ Adam  M+RP+修正"    { width: 82; height: 32;
    style.fill: "#34d399"; style.stroke: "#10b981"; style.border-radius: 4
    style.font-size: 9; style.font-color: "#022c22"; style.bold: true }
  o6: "" { width: 82; height: 32; style.opacity: 0 }
}

# ============================================================
# 数据
# ============================================================
data: {
  label: "数据  (Data)"
  style.fill: "#f5f0ff"
  style.stroke: "#8b5cf6"
  style.stroke-width: 2; style.border-radius: 10
  style.font-size: 13; style.font-color: "#6d28d9"; style.bold: true

  grid-rows: 3; grid-columns: 1; grid-gap: 4

  d1: "中心化  x−mean(x)" {
    width: 90; height: 32
    style.fill: "#ede9fe"; style.stroke: "#c4b5fd"; style.border-radius: 5
    style.font-size: 9; style.font-color: "#6d28d9" }
  d2: "标准化  (x−μ)/σ" {
    width: 90; height: 32
    style.fill: "#c4b5fd"; style.stroke: "#a78bfa"; style.border-radius: 5
    style.font-size: 9; style.font-color: "#4c1d95" }
  d3: "训练/验证分离  80%/20%" {
    width: 90; height: 32
    style.fill: "#ede9fe"; style.stroke: "#c4b5fd"; style.border-radius: 5
    style.font-size: 9; style.font-color: "#6d28d9" }
}

# ============================================================
# 防线
# ============================================================
guard: {
  label: "防线  (Guardrails)"
  style.fill: "#fff7ed"
  style.stroke: "#f97316"
  style.stroke-width: 2; style.border-radius: 10
  style.font-size: 13; style.font-color: "#9a3412"; style.bold: true

  grid-rows: 3; grid-columns: 1; grid-gap: 4

  g1: "过拟合  train↓ val↑" {
    width: 90; height: 32
    style.fill: "#ffedd5"; style.stroke: "#fdba74"; style.border-radius: 5
    style.font-size: 9; style.font-color: "#9a3412" }
  g2: "Early Stopping  验证不降就停" {
    width: 90; height: 32
    style.fill: "#fed7aa"; style.stroke: "#fb923c"; style.border-radius: 5
    style.font-size: 9; style.font-color: "#7c2d12" }
  g3: "patience  容忍 N 个 epoch" {
    width: 90; height: 32
    style.fill: "#fdba74"; style.stroke: "#f97316"; style.border-radius: 5
    style.font-size: 9; style.font-color: "#7c2d12" }
}

# ============================================================
# Root
# ============================================================
root: "机器学习" {
  shape: rectangle
  style.fill: "#f1f5f9"
  style.stroke: "#64748b"
  style.stroke-width: 2; style.border-radius: 12
  style.font-size: 16; style.font-color: "#1e293b"; style.bold: true
}

root -> row1
root -> row2

row1 -> model
row1 -> loss
row1 -> opt

row2 -> data
row2 -> guard
