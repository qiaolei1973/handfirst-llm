# ── v3 架构：神经元 → 隐藏层 → 完整网络 ──
#   由 generate-all.sh 自动构建，输出到 public/v3/architecture.svg

vars: {
  d2-config: {
    layout-engine: dagre
  }
}

direction: right

# ================================================================
# Layer 1: 什么是神经元？
# ================================================================
section-neuron: "① 一个神经元 = Linear + ReLU" {
  style.fill: "#f5f0ff"
  style.stroke: "#8b5cf6"
  style.stroke-width: 2
  style.stroke-dash: 8
  style.border-radius: 14
  style.font-size: 15
  style.font-color: "#6d28d9"

  x-input: "x" {
    shape: circle
    width: 48
    height: 48
    style.fill: "#e2e8f0"
    style.stroke: "#64748b"
    style.stroke-width: 2
    style.font-size: 14
    style.font-color: "#334155"
  }

  linear-op: "Linear\nWx + b" {
    shape: rectangle
    style.fill: "#dbeafe"
    style.stroke: "#3b82f6"
    style.stroke-width: 2
    style.border-radius: 8
    style.font-size: 13
    style.font-color: "#1d4ed8"
  }

  relu-op: "ReLU\nmax(0, z)" {
    shape: rectangle
    style.fill: "#fee2e2"
    style.stroke: "#ef4444"
    style.stroke-width: 2
    style.border-radius: 8
    style.font-size: 13
    style.font-color: "#b91c1c"
  }

  h-output: "h" {
    shape: circle
    width: 48
    height: 48
    style.fill: "#cffafe"
    style.stroke: "#06b6d4"
    style.stroke-width: 2
    style.font-size: 14
    style.font-color: "#0e7490"
  }

  x-input -> linear-op -> relu-op -> h-output
}

# ================================================================
# Layer 2: 隐藏层 = N 个神经元
# ================================================================
section-hidden: "② 隐藏层 = N 个神经元并行" {
  style.fill: "#fffdf5"
  style.stroke: "#f59e0b"
  style.stroke-width: 2
  style.stroke-dash: 8
  style.border-radius: 14
  style.font-size: 15
  style.font-color: "#92400e"

  n1: "神经元 1\nLinear+ReLU" {
    shape: rectangle
    style.fill: "#fef9c3"
    style.stroke: "#eab308"
    style.stroke-width: 2
    style.border-radius: 8
    style.font-size: 11
    style.font-color: "#854d0e"
  }

  n2: "神经元 2\nLinear+ReLU" {
    shape: rectangle
    style.fill: "#fef9c3"
    style.stroke: "#eab308"
    style.stroke-width: 2
    style.border-radius: 8
    style.font-size: 11
    style.font-color: "#854d0e"
  }

  ndots: "⋮" {
    shape: text
    style.font-size: 24
    style.font-color: "#94a3b8"
    style.bold: true
  }

  nN: "神经元 N\nLinear+ReLU" {
    shape: rectangle
    style.fill: "#fef9c3"
    style.stroke: "#eab308"
    style.stroke-width: 2
    style.border-radius: 8
    style.font-size: 11
    style.font-color: "#854d0e"
  }

  shared-input: "同一个输入 x" {
    shape: text
    style.font-size: 11
    style.font-color: "#64748b"
    style.italic: true
  }

  vector-output: "输出 N 维向量 [h₁, h₂, ..., hₙ]" {
    shape: text
    style.font-size: 11
    style.font-color: "#64748b"
    style.italic: true
  }
}

# ================================================================
# Layer 3: 完整架构 1 → N → 1
# ================================================================
section-full: "③ 完整网络：1 → N → 1" {
  style.fill: "#f0f9ff"
  style.stroke: "#3b82f6"
  style.stroke-width: 2
  style.stroke-dash: 8
  style.border-radius: 14
  style.font-size: 15
  style.font-color: "#1d4ed8"

  x-full: "x\n(1维输入)" {
    shape: circle
    width: 56
    height: 56
    style.fill: "#e2e8f0"
    style.stroke: "#64748b"
    style.stroke-width: 2
    style.font-size: 13
    style.font-color: "#334155"
  }

  hidden-full: "隐藏层\nN 个 ReLU 神经元" {
    style.fill: "#fffdf5"
    style.stroke: "#f59e0b"
    style.stroke-width: 2
    style.stroke-dash: 6
    style.border-radius: 12
    style.font-size: 13
    style.font-color: "#92400e"

    hf1: "h₁" {
      shape: circle
      width: 40
      height: 40
      style.fill: "#fef9c3"
      style.stroke: "#eab308"
      style.stroke-width: 1
      style.font-size: 11
      style.font-color: "#854d0e"
    }
    hf2: "h₂" {
      shape: circle
      width: 40
      height: 40
      style.fill: "#fef9c3"
      style.stroke: "#eab308"
      style.stroke-width: 1
      style.font-size: 11
      style.font-color: "#854d0e"
    }
    hfdots: "⋮" {
      shape: text
      style.font-size: 16
      style.font-color: "#94a3b8"
      style.bold: true
    }
    hfN: "hₙ" {
      shape: circle
      width: 40
      height: 40
      style.fill: "#fef9c3"
      style.stroke: "#eab308"
      style.stroke-width: 1
      style.font-size: 11
      style.font-color: "#854d0e"
    }
  }

  output-full: "输出层\nLinear 不加激活" {
    shape: rectangle
    style.fill: "#ecfdf5"
    style.stroke: "#10b981"
    style.stroke-width: 2
    style.border-radius: 10
    style.font-size: 13
    style.font-color: "#065f46"
  }

  ypred-full: "ŷ\n(预测值)" {
    shape: circle
    width: 56
    height: 56
    style.fill: "#cffafe"
    style.stroke: "#06b6d4"
    style.stroke-width: 2
    style.font-size: 13
    style.font-color: "#0e7490"
  }

  x-full -> hidden-full -> output-full -> ypred-full
}

# ================================================================
# Upward arrows showing the progressive build
# ================================================================
section-neuron -> section-hidden: {
  style.stroke: "#a78bfa"
  style.stroke-width: 1
  style.stroke-dash: 4
  style.opacity: 0.4
}

section-hidden -> section-full: {
  style.stroke: "#a78bfa"
  style.stroke-width: 1
  style.stroke-dash: 4
  style.opacity: 0.4
}
