      "isDeleted": false,
      "boundElements": null,
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "∂L/∂z = ∂L/∂h · ReLU'(z)\n(z>0 → 1,  z≤0 → 0)",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
