      "versionNonce": 11,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "∂L/∂w_out = ∂L/∂ŷ · h\n∂L/∂b_out = ∂L/∂ŷ\n∂L/∂h     = ∂L/∂ŷ · w_out",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle"
    },
    {
